ALTER TABLE enrollment ADD COLUMN discountAmount REAL NOT NULL DEFAULT 0.0 CHECK (discountAmount >= 0.0);
CREATE TABLE staff_member (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    role TEXT NOT NULL,
    phone TEXT NOT NULL,
    isActive INTEGER AS kotlin.Boolean NOT NULL CHECK (isActive IN (0, 1))
);

CREATE TABLE staff_shift (
    staffId TEXT NOT NULL REFERENCES staff_member(id) ON DELETE CASCADE,
    day INTEGER NOT NULL CHECK (day BETWEEN 1 AND 7),
    fromMinute INTEGER NOT NULL CHECK (fromMinute BETWEEN 0 AND 1439),
    toMinute INTEGER NOT NULL CHECK (toMinute BETWEEN 1 AND 1439 AND toMinute > fromMinute),
    PRIMARY KEY (staffId, day, fromMinute)
);

CREATE TABLE attendance_session (
    personType TEXT NOT NULL CHECK (personType IN ('STUDENT', 'TEACHER', 'STAFF')),
    personId TEXT NOT NULL,
    groupId TEXT NOT NULL DEFAULT '',
    date TEXT NOT NULL,
    checkInTime INTEGER NOT NULL,
    checkOutTime INTEGER CHECK (checkOutTime >= checkInTime),
    PRIMARY KEY (personType, personId, date, groupId)
);
CREATE INDEX attendance_session_date ON attendance_session(date);
