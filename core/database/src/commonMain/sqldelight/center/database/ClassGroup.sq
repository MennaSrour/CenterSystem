CREATE TABLE class_group (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    teacherId TEXT NOT NULL REFERENCES teacher(id) ON DELETE RESTRICT,
    sessionPrice REAL NOT NULL CHECK (sessionPrice >= 0),
    monthlyPriceMinor INTEGER CHECK (monthlyPriceMinor BETWEEN 0 AND 100000000000),
    commissionBasisPoints INTEGER CHECK (commissionBasisPoints BETWEEN 0 AND 10000),
    roomNumber INTEGER CHECK (roomNumber BETWEEN 1 AND 8),
    system TEXT NOT NULL DEFAULT 'BOTH' CHECK (system IN ('ARABIC', 'LANGUAGES', 'BOTH')),
    status TEXT NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'ARCHIVED')),
    gradeId TEXT,
    maxCapacity INTEGER CHECK (maxCapacity BETWEEN 1 AND 2147483647),
    lessonType TEXT NOT NULL DEFAULT 'ARABIC' CHECK (lessonType IN ('ARABIC', 'LANGUAGES', 'MIXED', 'PRIVATE')),
    languagesPriceMinor INTEGER CHECK (languagesPriceMinor BETWEEN 0 AND 100000000000)
);
CREATE INDEX class_teacher ON class_group(teacherId);

selectAll:
SELECT * FROM class_group ORDER BY id;

selectById:
SELECT * FROM class_group WHERE id = ?;

insertRow:
INSERT INTO class_group (id, name, teacherId, sessionPrice) VALUES (?, ?, ?, ?);

updateRow:
UPDATE class_group SET name = ?, teacherId = ?, sessionPrice = ? WHERE id = ?;

deleteById:
DELETE FROM class_group WHERE id = ?;
