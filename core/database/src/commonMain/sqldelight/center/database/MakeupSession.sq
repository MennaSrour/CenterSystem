CREATE TABLE makeup_session (
    id TEXT NOT NULL PRIMARY KEY,
    lesson_id TEXT NOT NULL REFERENCES class_group(id) ON DELETE CASCADE,
    original_canceled_date TEXT,
    makeup_date TEXT NOT NULL,
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    CHECK (start_time < end_time)
);
CREATE INDEX makeup_session_date ON makeup_session(makeup_date, start_time);
CREATE INDEX makeup_session_lesson ON makeup_session(lesson_id, makeup_date);

insertMakeupSession:
INSERT INTO makeup_session(id, lesson_id, original_canceled_date, makeup_date, start_time, end_time, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectMakeupSessionsForDate:
SELECT id, lesson_id AS lessonId, original_canceled_date AS originalCanceledDate,
       makeup_date AS makeupDate, start_time AS startTime, end_time AS endTime, notes, created_at AS createdAt
FROM makeup_session WHERE makeup_date = ? ORDER BY start_time, id;

selectMakeupSessionsForPeriod:
SELECT id, lesson_id AS lessonId, original_canceled_date AS originalCanceledDate,
       makeup_date AS makeupDate, start_time AS startTime, end_time AS endTime, notes, created_at AS createdAt
FROM makeup_session
WHERE (makeup_date >= ? AND makeup_date < ?)
   OR (original_canceled_date >= ? AND original_canceled_date < ?)
ORDER BY makeup_date, start_time, id;

hasMakeupSessionForLessonDate:
SELECT EXISTS(
    SELECT 1 FROM makeup_session WHERE id = ? AND lesson_id = ? AND makeup_date = ?
);
