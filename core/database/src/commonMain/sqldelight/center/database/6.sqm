CREATE TRIGGER attendance_session_sync_insert
AFTER INSERT ON attendance_session
BEGIN
    UPDATE attendance_session
    SET syncStatus = 'PENDING',
        updatedAt = max(new.updatedAt + 1, CAST(strftime('%s', 'now') AS INTEGER) * 1000)
    WHERE personType = new.personType AND personId = new.personId AND date = new.date AND groupId = new.groupId;
END;

CREATE TRIGGER attendance_session_sync_update
AFTER UPDATE OF checkInTime, checkOutTime ON attendance_session
BEGIN
    UPDATE attendance_session
